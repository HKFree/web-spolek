# Dev nasazení s redakcí (docker compose up -d --build). Zkopíruj do .env.

# Přihlášení: password = jméno, e-mail a sdílené heslo níže. Později oidc (hkfree účty).
AUTH_MODE=password
ADMIN_PASSWORD=

# Veřejná doména bez https:// (Astro pak věří hlavičkám X-Forwarded-* od proxy). Mění se při buildu.
PUBLIC_DOMAIN=
# Port, na kterém nginx poslouchá na hostiteli.
WEB_PORT=8080

# Záloha obsahu na GitHub. Bez GIT_REMOTE se obsah drží jen v lokálním git repozitáři ve volume.
GIT_REMOTE=
# GIT_REMOTE=git@github.com:HKFree/web-spolek.git
GIT_BRANCH=redakce-dev
GIT_PUSH=false
# GIT_SSH_COMMAND=ssh -i /run/secrets/deploy-key -o StrictHostKeyChecking=accept-new
