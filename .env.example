# Dev nasazení s redakcí (docker compose up -d --build). Zkopíruj do .env.

# Přihlášení: password = jméno, e-mail a sdílené heslo níže. Později oidc (hkfree účty).
# dev = jen jméno a e-mail bez hesla; jen tam, kam se nedostane nikdo cizí.
AUTH_MODE=password
ADMIN_PASSWORD=

# Veřejná doména bez https://, např. spolek.hkfree.org. Za HTTPS proxy (Apache) povinná,
# jinak redakce odmítne přihlášení i ukládání (403). Použije se při buildu image.
PUBLIC_DOMAIN=
# Port nginx na hostiteli. Za Apache na stejném stroji jen lokálně: WEB_PORT=127.0.0.1:8080
# (musí to být IP adresa, "localhost" compose nevezme). Samotné číslo = všechna rozhraní.
WEB_PORT=8080

# Záloha obsahu na GitHub. Bez GIT_REMOTE se obsah drží jen v lokálním git repozitáři ve volume.
GIT_REMOTE=
# GIT_REMOTE=git@github.com:HKFree/web-spolek.git
GIT_BRANCH=redakce-dev
GIT_PUSH=false
# GIT_SSH_COMMAND=ssh -i /run/secrets/deploy-key -o StrictHostKeyChecking=accept-new
