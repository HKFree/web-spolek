# Dev nasazení s redakcí, viz README.

# password = jméno, e-mail a heslo; dev = bez hesla (jen uzavřená síť)
AUTH_MODE=password
ADMIN_PASSWORD=

# Za HTTPS proxy povinné, jinak redakce vrací 403. Mění se při buildu.
PUBLIC_DOMAIN=
# Jen lokálně: 127.0.0.1:8080 (IP, ne localhost)
WEB_PORT=8080

# Záloha na GitHub, např. git@github.com:HKFree/web-spolek.git
GIT_REMOTE=
GIT_BRANCH=redakce-dev
GIT_PUSH=false
# GIT_SSH_COMMAND=ssh -i /run/secrets/deploy-key -o StrictHostKeyChecking=accept-new
