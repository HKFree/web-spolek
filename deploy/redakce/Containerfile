# Redakce pro dev nasazení (compose.yaml).
FROM docker.io/library/node:24-alpine
RUN apk add --no-cache git openssh-client \
 && mkdir -p /app /srv/repo /srv/www \
 && chown node:node /app /srv/repo /srv/www
# Bez rekurzivního chown, na overlayfs by kopíroval celé node_modules.
USER node
WORKDIR /app
COPY --chown=node:node package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY --chown=node:node . .
ARG PUBLIC_DOMAIN=
ENV ASTRO_TELEMETRY_DISABLED=1 NODE_ENV=production
RUN REDAKCE=server PUBLIC_DOMAIN="$PUBLIC_DOMAIN" npx astro build
EXPOSE 4321
CMD ["node", "deploy/redakce/start.mjs"]
