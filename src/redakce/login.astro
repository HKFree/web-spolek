---
import { authMode, currentUser, login, safeReturnTo, validPassword } from './auth';

export const prerender = false;

const returnTo = safeReturnTo(Astro.url.searchParams.get('returnTo'));
if (currentUser(Astro.cookies)) return Astro.redirect(returnTo, 302);

const mode = authMode();
if (mode === 'oidc') {
  return new Response('Přihlášení přes hkfree účet (OIDC) zatím není hotové.', { status: 503 });
}
if (mode === 'off') {
  return new Response('Redakce je zavřená: přihlášení není nastavené (AUTH_MODE).', { status: 503 });
}

let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const name = String(form.get('name') ?? '').trim();
  const email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');
  if (!name || !/^[^\s@]+@[^\s@]+$/.test(email)) {
    error = 'Vyplň jméno a platný e-mail.';
  } else if (mode === 'password' && !validPassword(password)) {
    await new Promise((resolve) => setTimeout(resolve, 1000));
    error = 'Špatné heslo.';
  } else {
    login(Astro.cookies, { name, email }, Astro.url.protocol === 'https:');
    return Astro.redirect(safeReturnTo(String(form.get('returnTo') ?? '')), 303);
  }
}
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Přihlášení do redakce | hkfree.org z.s.</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #f4f1ea; font: 16px/1.5 system-ui, sans-serif; color: #16181d; }
      form { background: #fff; padding: 32px; border-radius: 12px; box-shadow: 0 4px 24px rgb(0 0 0 / 8%); width: min(360px, 90vw); }
      h1 { margin: 0 0 4px; font-size: 1.4rem; }
      p { margin: 0 0 20px; color: #555; font-size: 0.9rem; }
      label { display: block; margin-bottom: 14px; font-weight: 600; font-size: 0.9rem; }
      input { display: block; width: 100%; box-sizing: border-box; margin-top: 4px; padding: 10px; border: 1px solid #ccc; border-radius: 8px; font: inherit; }
      button { width: 100%; padding: 12px; border: 0; border-radius: 8px; background: #cc0000; color: #fff; font: inherit; font-weight: 600; cursor: pointer; }
      .error { color: #cc0000; }
      .dev { background: #fff6d6; border-radius: 8px; padding: 8px 10px; color: #6b5300; }
    </style>
  </head>
  <body>
    <form method="post">
      <h1>Redakce hkfree.org z.s.</h1>
      <p class="dev">
        Testovací verze: místo hkfree účtu zadej jméno a e-mail{mode === 'password' && ' a heslo redakce'}. Použijí se jako autor změn.
      </p>
      {error && <p class="error">{error}</p>}
      <input type="hidden" name="returnTo" value={returnTo} />
      <label>Jméno <input name="name" autocomplete="name" required /></label>
      <label>E-mail <input name="email" type="email" autocomplete="email" required /></label>
      {mode === 'password' && <label>Heslo redakce <input name="password" type="password" autocomplete="current-password" required /></label>}
      <button type="submit">Přihlásit se</button>
    </form>
  </body>
</html>
